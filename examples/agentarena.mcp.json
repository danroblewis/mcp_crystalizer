{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    "deepwiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "git": {
      "command": "{{project}}/.venv/bin/python",
      "args": ["{{project}}/crystal/servers/git.py", "--root", "{{workspace}}"]
    },
    "code": {
      "command": "{{project}}/.venv/bin/python",
      "args": ["{{project}}/crystal/servers/code.py", "--root", "{{workspace}}"]
    },
    "jira": { "disabled": true },
    "slack": { "disabled": true },
    "confluence": { "disabled": true },
    "logz": { "disabled": true },
    "chronosphere": { "disabled": true },
    "pagerduty": { "disabled": true }
  }
}
